[
  {"id": "android_version", "kind": "info", "goal": "What is my Android version?",
   "expected_cmd": "getprop ro.build.version.release"},
  {"id": "build_number", "kind": "info", "goal": "What is the build number of this phone?",
   "expected_cmd": "getprop ro.build.id"},
  {"id": "device_model", "kind": "info", "goal": "What phone model is this?",
   "expected_cmd": "getprop ro.product.model"},
  {"id": "battery_level", "kind": "info", "goal": "How much battery do I have left?",
   "expected_cmd": "dumpsys battery", "extract": "level: (\\d+)", "transform": "pct",
   "note": "status bar says 'Battery 100 percent.' but only APPLICATION windows are checked, so the Battery page's '100%' is needed"},
  {"id": "security_update", "kind": "info", "goal": "When was the last Android security update?",
   "expected_cmd": "getprop ro.build.version.security_patch", "transform": "date_long",
   "note": "shown under About > Android version > Android security update"},
  {"id": "kernel_version", "kind": "info", "goal": "Which kernel version is my phone running?",
   "expected_cmd": "uname -r", "extract": "^([\\d.]+)",
   "note": "shown under About > Android version > Kernel version"},
  {"id": "wifi_name", "kind": "info", "goal": "Which Wi-Fi network am I connected to?",
   "expected_cmd": "cmd wifi status", "extract": "SSID: \"([^\"]+)\""},
  {"id": "ip_address", "kind": "info", "goal": "What is my phone's IP address?",
   "expected_cmd": "ip -4 addr show wlan0", "extract": "inet ([\\d.]+)"},
  {"id": "screen_timeout_info", "kind": "info", "goal": "How long does my screen stay on before it turns off?",
   "expected_cmd": "settings get system screen_off_timeout", "transform": "ms_minutes"},
  {"id": "time_zone", "kind": "info", "goal": "What time zone is my phone set to?",
   "expected_cmd": "date +%z", "transform": "gmt_offset"},

  {"id": "dark_theme", "kind": "set", "goal": "Turn on dark theme",
   "check_cmd": "cmd uimode night", "expect": "Night mode: yes"},
  {"id": "airplane_mode", "kind": "set", "goal": "Turn on airplane mode",
   "check_cmd": "settings get global airplane_mode_on", "expect": "^1$"},
  {"id": "screen_timeout_5min", "kind": "set", "goal": "Make the screen turn off after 5 minutes",
   "check_cmd": "settings get system screen_off_timeout", "expect": "^300000$"},
  {"id": "battery_saver", "kind": "set", "goal": "Turn on battery saver",
   "check_cmd": "settings get global low_power", "expect": "^1$"},
  {"id": "battery_percentage", "kind": "set", "goal": "Show the battery percentage in the status bar",
   "check_cmd": "settings get system status_bar_show_battery_percent", "expect": "^1$",
   "note": "replaces Night Light: the emulator has no night display (color_display: Not available)"},
  {"id": "do_not_disturb", "kind": "set", "goal": "Turn on Do Not Disturb",
   "check_cmd": "settings get global zen_mode", "expect": "^[1-9]"},
  {"id": "wifi_off", "kind": "set", "goal": "Turn off Wi-Fi",
   "check_cmd": "settings get global wifi_on", "expect": "^0$"},
  {"id": "color_inversion", "kind": "set", "goal": "Invert the screen colors",
   "check_cmd": "settings get secure accessibility_display_inversion_enabled", "expect": "^1$"},
  {"id": "extra_dim", "kind": "set", "goal": "Make the screen extra dim",
   "check_cmd": "settings get secure reduce_bright_colors_activated", "expect": "^1$"},
  {"id": "bold_text", "kind": "set", "goal": "Make all text bold",
   "check_cmd": "settings get secure font_weight_adjustment", "expect": "^[1-9]"},
  {"id": "clock_24h", "kind": "set", "goal": "Show the time in 24-hour format",
   "check_cmd": "settings get system time_12_24", "expect": "^24$",
   "note": "needs 'Use locale default' off first; the 'Use 24-hour format' row contains 'format', which is on the uinav unsafe blocklist, so this documents an expected unsafe_blocked"},
  {"id": "location_off", "kind": "set", "goal": "Stop apps from using my location",
   "check_cmd": "settings get secure location_mode", "expect": "^0$"},
  {"id": "bluetooth_off", "kind": "set", "goal": "Turn off Bluetooth",
   "check_cmd": "settings get global bluetooth_on", "expect": "^0$",
   "note": "replaces auto-rotate: the emulator's Auto-rotate screen page shows no toggle"},
  {"id": "high_contrast_text", "kind": "set", "goal": "Turn on high contrast text",
   "check_cmd": "settings get secure high_text_contrast_enabled", "expect": "^1$",
   "note": "replaces adaptive brightness: the emulator has no light sensor, so the option is absent"},
  {"id": "font_size_max", "kind": "set", "goal": "Make the font size as large as possible",
   "check_cmd": "settings get system font_scale", "expect": "^2(\\.0)?$",
   "note": "Display size and text > Font size 'Make larger' (+) pressed 6 times: 1.0 -> 2.0"},

  {"id": "bluetooth_page", "kind": "open", "goal": "Open the Bluetooth settings",
   "package": "^com\\.android\\.settings$", "layout_re": "^window: Bluetooth$",
   "note": "Connected devices > Connection preferences > Bluetooth"},
  {"id": "stopwatch_open", "kind": "open", "goal": "Open the stopwatch",
   "package": "^com\\.google\\.android\\.deskclock$", "layout_re": "^window: Stopwatch$"},
  {"id": "stopwatch_start", "kind": "open", "goal": "Start the stopwatch",
   "package": "^com\\.google\\.android\\.deskclock$", "layout_re": "(?s)^window: Stopwatch$.*^Pause$"},
  {"id": "notification_history", "kind": "open", "goal": "Show my notification history",
   "package": "^com\\.android\\.settings$", "layout_re": "^window: Notification history$"},
  {"id": "all_apps_list", "kind": "open", "goal": "In Settings, show me all the apps installed on my phone",
   "package": "^com\\.android\\.settings$", "layout_re": "^window: All apps$",
   "note": "the launcher's app drawer is also titled 'All apps'; the package check requires Settings > Apps > See all apps"}
]
